import { useState } from 'react';
import { Art } from '../Art';
import { artwork } from '../assets';
import { journey, artifacts } from '../content';
import { Artifact, Modal, PageControls, ReadingPages } from '../components';
import { useStored } from '../lib';
export default function Journey({go}:{go:()=>void}){
 const [place,setPlace]=useState(0);const [active,setActive]=useState<number|null>(null);const [gallery,setGallery]=useState(false);const [artifact,setArtifact]=useState(0);const [visited,setVisited]=useStored<number[]>('katherine-journey-v1',[]);const [controller,setController]=useState('');
 function visit(i:number){setActive(i);setGallery(false);setArtifact(0);setController('');setVisited(v=>v.includes(i)?v:[...v,i]);}
 const j=journey[place];
 return <div className={`journey-stage location-${place}`}><div className="landscape-window"><div className="landscape-pan" style={{'--place':place} as React.CSSProperties}><img src={artwork.journey} alt="A painted scrapbook landscape with a school, shared game table, art studio, closed campus gate, and distant houses"/><svg className="journey-thread" viewBox="0 0 2172 724" aria-hidden="true"><path d="M0 510Q180 520 250 600T510 540T840 630T1260 610T1680 620T2172 460"/></svg>{journey.map((item,i)=><button key={item.title} className={`landmark-pin pin-${i} ${visited.includes(i)?'visited':''}`} onClick={()=>{setPlace(i);visit(i);}} aria-label={`Open ${item.title}`}><span>{String(i+1).padStart(2,'0')}</span></button>)}</div>{place===3&&<button className="campus-plant" onClick={()=>visit(3)} aria-label="Open the sticker plant memory"><img src={artwork.plant} alt="A carefully kept campus plant with a faded blue heart sticker"/><span>the sticker is still here.</span></button>}<div className="location-tag"><span>{String(place+1).padStart(2,'0')} / 05</span><h2>{j.title}</h2></div></div><div className="journey-bottom"><div className="journey-note"><span className="eyebrow">{j.eyebrow.toLowerCase()}</span><p>{j.note}</p></div><button className="button primary" onClick={()=>visit(place)}>Open this memory ↗</button><PageControls page={place} count={journey.length} setPage={setPlace} label="Place"/>{place===4&&<button className="text-button journey-to-letter" onClick={go}>Follow the thread to your letter →</button>}</div>{active!==null&&<Modal title={journey[active].title} onClose={()=>setActive(null)} className={gallery?'archive-modal':''}>{gallery&&journey[active].artifacts?<><button className="text-button" onClick={()=>setGallery(false)}>← Back to the memory</button><Artifact id={journey[active].artifacts![artifact]}/><PageControls page={artifact} count={journey[active].artifacts!.length} setPage={setArtifact} label="Artifact"/></>:<div className={`journey-memory journey-memory-${active}`}>{active===3?<img className="memory-plant" src={artwork.plant} alt="The little campus plant"/>:<Art kind={journey[active].motif}/>}<span className="eyebrow">{journey[active].eyebrow.toLowerCase()}</span><h2>{journey[active].title}</h2><ReadingPages text={journey[active].text}/>{active===1&&<div className="shared-game"><div className={`mini-world ${controller}`}><i className="block block-1"/><i className="block block-2"/><i className="block block-3"/><span className="game-player"/></div><div><button className="button" onClick={()=>setController(c=>c==='mouse'?'':'mouse')}>Katherine’s mouse ↗</button><button className="button" onClick={()=>setController(c=>c==='keyboard'?'':'keyboard')}>Carrie’s keyboard →</button></div></div>}{journey[active].artifacts&&<button className="button" onClick={()=>setGallery(true)}>Open the {active===2?'project portfolio':'original message'} ↗</button>}</div>}</Modal>}</div>
}
